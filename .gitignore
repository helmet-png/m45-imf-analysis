# ============================================================
# 大型資料檔：可重新產生，不進版控
# ============================================================
# isochrone 網格（603 MB，單檔最大 153 MB，超過 GitHub 100 MB 硬上限）
# 重建方式見 README.md 的「環境建置」：
#   python build_mist_grid.py      -> MIST v1.2 打包檔與轉檔
#   python build_dr2_grid.py       -> PARSEC DR2 濾光片版
#   pipeline/isochrones.py 會自動下載 PARSEC EDR3 網格
isochrones/

# 文獻 PDF（zotero_literature_sync.py 從 arXiv 下載，92 MB）：本體已經
# 同步進 Zotero，這裡只是下載時的本機快取（重跑腳本會跳過已存在的
# 檔案，不用每次重下）。不進版控——公開 repo 重新散布論文全文不合適，
# 也會讓 repo 體積暴增。
literature/

# Kaggle 執行的暫存與回傳結果（353 MB，多數是上傳資料的回傳副本）
kaggle_work/
kaggle_results/

# results/ 改為版控追蹤（使用者 2026-08-09 指示：每次跑完的結果都推上去）。
# 不排除。

# Gaia 原始下載檔（大且可重新查詢）
data/m45_r5_g18_plx4.csv
data/m45_r5_g20_plx4.csv
data/comparison.csv
data/astrophys.csv

# ============================================================
# 執行過程產物
# ============================================================
logs/
figs/
__pycache__/
*.pyc
prepared/
.venv*/
.pdmf-packages/
.pdmf-local/
.nbody-local/

# astro-limepy 需要的 scipy 舊版（1.16.3，不能跟本專案主環境共用，見
# scripts/diagnostics/limepy_multimass.py 開頭說明），本機獨立 venv 不進版控
.venv_limepy/

# ============================================================
# 憑證與機敏檔案：絕不進版控
# ============================================================
# PARSEC 的 CA 鏈，由 setup_ca.ps1 在本機重新產生
certs/
*.pem
# Zotero API key（zotero_sync.py 讀這個檔案的 ZOTERO_API_KEY/ZOTERO_LIBRARY_ID）
.env
kaggle.json
access_token
# 多帳號憑證登記檔（每位成員一個 token），只有範本 kaggle_accounts.json.example
# 進版控，真檔案含機敏 token 絕不進版控。
kaggle_accounts.json

# ============================================================
# 第三方原始碼：用 clone 取得，不納入本 repo
# ============================================================
# pyUPMASK 來自 https://github.com/msolpera/pyUPMASK
# 我們對它的修改記錄在 README.md，不直接夾帶對方的程式碼
pyUPMASK/

